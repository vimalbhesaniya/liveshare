# ─── Frontend ───────────────────────────────────────────────────────────
# Backend URL for API + Socket.io. Leave empty to use Vite proxy (/api → :3000).
VITE_BACKEND_URL=http://localhost:3000

# ─── EmailJS (optional — feedback / contact form) ───────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─── Maintenance (optional) ───────────────────────────────────────────
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_MESSAGE="We're doing some improvements right now. Please check back in a bit."
